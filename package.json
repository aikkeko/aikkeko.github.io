{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/site.js build",
    "clean": "hexo clean",
    "deploy": "node tools/site.js deploy",
    "deploy:check": "node tools/site.js deploy --dry-run",
    "test": "node --test tools/tests/*.test.js",
    "validate": "node tools/validate-build.js",
    "server": "hexo server",
    "visual:check": "node tools/visual-regression.js",
    "manage": "node content-manager/server.js",
    "pipeline": "node content-pipeline/cli.js",
    "pipeline:once": "node content-pipeline/cli.js --once",
    "pipeline:metadata": "node content-pipeline/sync-metadata.js",
    "pipeline:media-covers": "node content-pipeline/sync-media-covers.js"
  },
  "hexo": {
    "version": "5.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "cheerio": "^1.2.0",
    "chokidar": "^3.6.0",
    "dotenv": "^17.3.1",
    "hexo": "^5.0.0",
    "hexo-deployer-git": "^3.0.0",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^2.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^1.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^4.0.0",
    "hexo-renderer-stylus": "^2.0.0",
    "hexo-server": "^2.0.0",
    "hexo-wordcount": "^6.0.1",
    "mammoth": "^1.11.0"
  }
}
