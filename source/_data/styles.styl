// 版本信息（用于调试）
:root {
  --theme-version: "2026.08.20-01";
  --theme-name: "Z.A.T.O Apocalypse";
  --font-reading:
    "Noto Sans SC",
    "Source Han Sans SC",
    "Noto Sans CJK SC",
    "PingFang SC",
    "Microsoft YaHei UI",
    "Microsoft YaHei",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  --font-display:
    "Noto Sans SC",
    "Source Han Sans SC",
    "Noto Sans CJK SC",
    "PingFang SC",
    "Microsoft YaHei UI",
    "Microsoft YaHei",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  --font-prose:
    "Noto Sans SC",
    "Source Han Sans SC",
    "Noto Sans CJK SC",
    "PingFang SC",
    "Microsoft YaHei UI",
    "Microsoft YaHei",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  --font-latin-display:
    "Bodoni MT",
    Didot,
    "Times New Roman",
    Georgia,
    serif;
  --font-label:
    "IBM Plex Mono",
    "Cascadia Mono",
    Consolas,
    "Courier New",
    monospace;
  // ===== 全面覆盖 NexT 默认白色系 CSS 变量 =====
  // 背景色
  --content-bg-color: rgba(35, 38, 45, 0.85);
  --body-bg-color: #1e2128;
  --card-bg-color: rgba(40, 43, 50, 0.7);
  --table-row-odd-bg-color: rgba(35, 38, 45, 0.5);
  --table-row-hover-bg-color: rgba(50, 53, 60, 0.5);
  --menu-item-bg-color: rgba(180, 160, 120, 0.1);
  // 文字色
  --text-color: #c8c8cc;
  --blockquote-color: #a0a0a0;
  // 链接色
  --link-color: #d4c4a8;
  --link-hover-color: #e4d4b8;
  // 品牌色
  --brand-color: #e8e4dc;
  --brand-hover-color: #d4c4a8;
  // 按钮
  --btn-default-bg: rgba(40, 43, 50, 0.8);
  --btn-default-color: #c8c8cc;
  --btn-default-border-color: rgba(180, 160, 120, 0.3);
  --btn-default-hover-bg: rgba(180, 160, 120, 0.2);
  --btn-default-hover-color: #e8e4dc;
  --btn-default-hover-border-color: rgba(180, 160, 120, 0.5);
}


// Ordered modules: keep this sequence stable because later layers refine earlier rules.
@import "styles/00-foundation"
@import "styles/10-home-editorial"
@import "styles/20-archive-pages"
@import "styles/30-reading-shell"
@import "styles/40-cards-media"
@import "styles/50-comments-final"
