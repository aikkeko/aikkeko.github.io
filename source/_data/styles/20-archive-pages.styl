    }
  }
}

// ============================================
// 30. Z.A.T.O background maxims - faded archive signage
// ============================================
.zato-background-quotes {
  position: fixed;
  inset: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
  user-select: none;
  mix-blend-mode: screen;
}

.zato-quote {
  position: absolute;
  display: block;
  color: rgba(232, 228, 220, 0.28);
  font-family:
    "Times New Roman",
    Georgia,
    "Noto Serif SC",
    serif;
  font-size: clamp(0.66rem, 0.72vw, 0.86rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  white-space: nowrap;
  text-shadow:
    0 0 14px rgba(212, 196, 168, 0.18),
    0 2px 8px rgba(0, 0, 0, 0.78);
