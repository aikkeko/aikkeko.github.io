    background-color: transparent !important;
    background-attachment: scroll !important;
    box-shadow: none !important;
  }

  .hero-mask {
    background:
      radial-gradient(ellipse at 58% 42%, rgba(12, 14, 18, 0) 0%, rgba(12, 14, 18, 0.08) 46%, rgba(12, 14, 18, 0.34) 100%),
      linear-gradient(180deg, rgba(10, 12, 16, 0.02) 0%, rgba(10, 12, 16, 0.16) 60%, rgba(10, 12, 16, 0.52) 100%) !important;
  }

  .hero-section::before {
    opacity: 0.28;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px) !important;
    background-size: 96px 96px !important;
  }

  .hero-section::after {
    background:
      linear-gradient(90deg, rgba(212, 196, 168, 0.42) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.42) calc(100% - 48px)) top / 100% 1px no-repeat,
      linear-gradient(90deg, rgba(212, 196, 168, 0.42) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.42) calc(100% - 48px)) bottom / 100% 1px no-repeat,
      linear-gradient(180deg, rgba(212, 196, 168, 0.42) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.42) calc(100% - 48px)) left / 1px 100% no-repeat,
      linear-gradient(180deg, rgba(212, 196, 168, 0.42) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.42) calc(100% - 48px)) right / 1px 100% no-repeat !important;
    border-color: rgba(212, 196, 168, 0.16) !important;
    box-shadow: none !important;
  }
}

