// ============================================
// 27. Archive page - chronological archive wall
// ============================================
.archive {
  .post-block {
    overflow: hidden;
  }

  .archive-hero {
    position: relative;
    margin: -6px -12px 42px;
    padding: 34px 38px 30px;
    border: 1px solid rgba(212, 196, 168, 0.18);
    background:
      linear-gradient(135deg, rgba(212, 196, 168, 0.13), rgba(35, 38, 45, 0.18) 42%, rgba(106, 160, 154, 0.08)),
      repeating-linear-gradient(90deg, transparent 0, transparent 12px, rgba(255, 255, 255, 0.025) 12px, rgba(255, 255, 255, 0.025) 13px);
    box-shadow:
      0 18px 54px rgba(0, 0, 0, 0.26),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset;

    &::before {
  content: 'ARCHIVE / INDEX';
      position: absolute;
      right: 28px;
      top: 22px;
      color: rgba(212, 196, 168, 0.32);
      font-size: 0.72em;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    &::after {
      content: '';
      position: absolute;
      left: 28px;
      right: 28px;
      bottom: 0;
      height: 1px;
      background: linear-gradient(90deg, rgba(212, 196, 168, 0.65), transparent);
    }
  }

  .archive-hero-kicker {
    color: rgba(106, 160, 154, 0.92);
    font-size: 0.75em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .archive-hero-title {
    margin: 8px 0 8px;
    color: #fff8ea;
    font-size: 2.3em;
    line-height: 1.12;
    letter-spacing: 0;
    text-shadow:
      0 12px 30px rgba(0, 0, 0, 0.42),
      0 0 24px rgba(212, 196, 168, 0.18);
  }

  .archive-hero-desc {
    max-width: 36em;
    margin: 0;
    color: rgba(232, 228, 220, 0.72);
    line-height: 1.7;
  }

  .archive-hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;

    span {
      display: inline-flex;
      align-items: baseline;
      gap: 7px;
      padding: 7px 10px;
      color: rgba(232, 228, 220, 0.72);
      border: 1px solid rgba(212, 196, 168, 0.16);
      background: rgba(18, 20, 26, 0.28);
      font-size: 0.82em;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    strong {
      color: #d4c4a8;
      font-size: 1.18em;
      letter-spacing: 0;
    }
  }

  .posts-collapse {
    margin-left: 0;
    padding-left: 68px;
    counter-reset: archive-item;

    &::before {
      left: 30px;
      top: 0;
      width: 1px;
      margin-left: 0;
      background:
        linear-gradient(180deg, transparent, rgba(212, 196, 168, 0.65) 10%, rgba(106, 160, 154, 0.36) 58%, transparent);
      box-shadow: 0 0 24px rgba(212, 196, 168, 0.16);
    }
  }

  .collection-title {
    margin-bottom: 32px;
    padding: 14px 18px;
    border: 1px solid rgba(212, 196, 168, 0.12);
    background: rgba(18, 20, 26, 0.2);

    &::before {
      left: -38px;
      width: 13px;
      height: 13px;
      margin-left: 0;
      border: 1px solid rgba(212, 196, 168, 0.85);
      background: #1e2128;
      box-shadow:
        0 0 0 5px rgba(212, 196, 168, 0.08),
        0 0 22px rgba(212, 196, 168, 0.28);
    }

    .collection-header {
      margin-left: 0;
      color: rgba(232, 228, 220, 0.76);
      font-size: 0.9em;
      letter-spacing: 0.02em;
    }
  }

  .collection-year {
    margin: 54px 0 24px;

    &::before {
      left: -42px;
      width: 21px;
      height: 21px;
      margin-left: 0;
      border: 1px solid rgba(212, 196, 168, 0.72);
      background:
        radial-gradient(circle, #d4c4a8 0 3px, #1e2128 4px);
      box-shadow:
        0 0 0 6px rgba(212, 196, 168, 0.08),
        0 0 30px rgba(212, 196, 168, 0.28);
    }

    .collection-header {
      display: inline-flex;
      margin-left: 0;
      padding: 4px 12px 5px;
      color: #fff8ea;
      border: 1px solid rgba(212, 196, 168, 0.2);
      background:
        linear-gradient(135deg, rgba(212, 196, 168, 0.14), rgba(18, 20, 26, 0.24));
      font-size: 1.45em;
      line-height: 1.2;
      letter-spacing: 0.02em;
    }
  }

  .posts-collapse article {
    position: relative;
    counter-increment: archive-item;
  }

  .posts-collapse .post-header {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    margin: 14px 0;
    padding: 14px 18px;
    border: 1px solid rgba(212, 196, 168, 0.1);
    border-bottom: 1px solid rgba(212, 196, 168, 0.1);
    background:
      linear-gradient(135deg, rgba(49, 51, 57, 0.54), rgba(24, 27, 34, 0.38));
    transition:
      transform 0.24s ease,
      border-color 0.24s ease,
      background 0.24s ease,
      box-shadow 0.24s ease;

    &::before {
      left: -43px;
      top: 50%;
      width: 10px;
      height: 10px;
      margin-left: 0;
      margin-top: -5px;
      border: 1px solid rgba(212, 196, 168, 0.56);
      background: #1e2128;
      box-shadow: 0 0 0 4px rgba(212, 196, 168, 0.05);
    }

    &::after {
      content: counter(archive-item, decimal-leading-zero);
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(212, 196, 168, 0.18);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.7em;
      line-height: 1;
      pointer-events: none;
    }

    &:hover {
      transform: translateX(8px);
      border-color: rgba(212, 196, 168, 0.28);
      background:
        linear-gradient(135deg, rgba(65, 67, 73, 0.66), rgba(26, 29, 36, 0.48));
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);

      &::before {
        background: #d4c4a8;
      }
    }
  }

  .posts-collapse .post-meta {
    display: block;
    margin: 0;
    color: #d4c4a8;
    font-size: 0.82em;

    time {
      display: inline-flex;
      justify-content: center;
      min-width: 58px;
      padding: 5px 8px;
      border: 1px solid rgba(212, 196, 168, 0.2);
      background: rgba(16, 18, 22, 0.34);
      letter-spacing: 0.06em;
    }
  }

  .posts-collapse .post-title {
    display: block;
    padding-right: 48px;
    font-size: 1.05em;

    a,
    span.exturl {
      color: #e8e4dc;
      background-image: linear-gradient(90deg, rgba(212, 196, 168, 0.55), rgba(106, 160, 154, 0.38));
      background-position: 0 100%;
      background-repeat: no-repeat;
      background-size: 0 1px;
      transition:
        color 0.2s ease,
        background-size 0.24s ease;

      &:hover {
        color: #fff8ea;
        background-size: 100% 1px;
      }
    }
  }
}

@media (max-width: $viewport-mobile) {
  .archive {
    .archive-hero {
      margin: -2px 0 32px;
      padding: 28px 22px 24px;

      &::before {
        position: static;
        display: block;
        margin-bottom: 12px;
      }
    }

    .archive-hero-title {
      font-size: 1.85em;
    }

    .archive-hero-stats span {
      font-size: 0.72em;
    }

    .posts-collapse {
      padding-left: 38px;
      margin-left: 0;
      margin-right: 0;

      &::before {
        left: 16px;
      }
    }

    .collection-title::before,
    .collection-year::before,
    .posts-collapse .post-header::before {
      left: -28px;
    }

    .posts-collapse .post-header {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 14px 16px;
    }

    .posts-collapse .post-title {
      padding-right: 30px;
    }
  }
}

// ============================================
// 28. Homepage title refinement - quieter literary masthead
// ============================================
.index {
  .hero-section::after {
    border-bottom-color: transparent !important;
    background:
      linear-gradient(90deg, rgba(212, 196, 168, 0.5) 0 42px, transparent 42px calc(100% - 42px), rgba(212, 196, 168, 0.5) calc(100% - 42px)) top / 100% 1px no-repeat,
      linear-gradient(180deg, rgba(212, 196, 168, 0.48) 0 42px, transparent 42px calc(100% - 42px), rgba(212, 196, 168, 0.28) calc(100% - 42px)) left / 1px 100% no-repeat,
      linear-gradient(180deg, rgba(212, 196, 168, 0.48) 0 42px, transparent 42px calc(100% - 42px), rgba(212, 196, 168, 0.28) calc(100% - 42px)) right / 1px 100% no-repeat !important;
  }

  .site-title-main {
    font-family:
      "Noto Serif SC",
      "Source Han Serif SC",
      "Songti SC",
      "SimSun",
      serif;
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08),
      0 3px 8px rgba(0, 0, 0, 0.88),
      0 14px 34px rgba(0, 0, 0, 0.62),
      0 0 18px rgba(212, 196, 168, 0.18) !important;
  }

  .hero-text {
    &::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 58%;
      width: unquote('min(640px, 78vw)');
      height: 44%;
      transform: translate(-50%, -50%);
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(ellipse at center, rgba(8, 10, 14, 0.46), rgba(8, 10, 14, 0) 68%);
      filter: blur(6px);
    }
  }

  .site-subtitle-main {
    color: rgba(232, 220, 198, 0.92);
    font-size: 1.28em;
    letter-spacing: 0.06em;
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.9),
      0 0 16px rgba(212, 196, 168, 0.2);
  }

  .hero-kicker {
    color: rgba(232, 228, 220, 0.84);
  }
}

@media (max-width: $viewport-mobile) {
  .index {
    .site-title-main {
      line-height: 1.18;
    }

    .site-subtitle-main {
      font-size: 0.92em;
      letter-spacing: 0.03em;
    }
  }
}

