// Responsive component contract. Keep mobile geometry in this one layer.
@media (max-width: $viewport-mobile) {
  body::after {
    background-image: var(--dream-landscape);
    background-size: cover;
    background-position: center;
    mix-blend-mode: normal;
    opacity: 1;
  }
  body .media-archive .media-card-title,
  body .media-archive .media-card.is-featured .media-card-title { font-size: 20px; }
  body .media-toolbar.is-filtering { grid-template-columns: minmax(0, 1fr); }
  body .reading-surface .post-footer { margin-top: 30px; }
  body .giscus-comments { margin-top: 24px !important; }
  body .footer-inner { padding-top: 28px !important; padding-bottom: unquote('max(24px, env(safe-area-inset-bottom))') !important; }
  body .media-search input { font-size: 16px !important; }
  // 70px brand row + the existing 2px frame, identical on every page.
  body .header .header-inner .site-brand-container {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    height: 70px !important;
    min-height: 70px !important;
    padding: 12px 56px !important;
    box-sizing: border-box;
  }

  body .header .site-brand-container .site-meta {
    margin: 0 auto !important;
    max-width: calc(100vw - 112px);
  }

  body .header .site-nav-toggle,
  body .header .site-nav-right {
    top: 50% !important;
    width: 44px;
    height: 44px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
  }

  body .header .site-nav-toggle { left: 6px !important; }
  body .header .site-nav-right { right: 6px !important; }

  body .header .site-nav-toggle button.toggle {
    width: 44px;
    height: 44px;
    padding: 16px 11px;
    box-sizing: border-box;
  }

  body .header .site-nav-right .toggle {
    box-sizing: border-box;
    padding: 0 !important;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 18px;
  }

  body .content .page-identity-hero,
  body .content .archive-hero {
    padding: 18px 18px 17px !important;
    margin-bottom: 20px !important;
    min-height: 0 !important;
  }

  body .content .page-hero-title,
  body .content .archive-hero-title {
    margin: 8px 0 !important;
    font-size: 28px !important;
    font-weight: 500 !important;
    line-height: 1.25 !important;
  }

  body .content .page-hero-desc,
  body .content .archive-hero-desc {
    font-size: 15px !important;
    line-height: 1.65 !important;
  }

  body .content .page-hero-stats,
  body .content .archive-hero-stats {
    margin-top: 14px !important;
    gap: 8px;
  }

  body .content .page-hero-stats span,
  body .content .archive-hero-stats span {
    padding: 5px 9px !important;
    font-size: 12px !important;
  }

  body.home-page {
    max-width: 100%;
    overflow-x: hidden;
    overflow-x: clip;
  }

  body.home-page .main,
  body.home-page .main-inner,
  body.home-page .content-wrap,
  body.home-page .content.index,
  body.home-page .hero-section {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    margin-right: 0 !important;
    margin-left: 0 !important;
    box-sizing: border-box;
  }

  body.home-page .main-inner,
  body.home-page .content-wrap,
  body.home-page .content.index,
  body.home-page .hero-section {
    overflow-x: hidden;
    overflow-x: clip;
  }

  body.home-page .hero-content {
    padding-top: 24px !important;
    width: 100% !important;
    min-width: 0;
    max-width: 100%;
    padding-right: 28px !important;
    padding-left: 28px !important;
    box-sizing: border-box;
  }

  body.home-page .hero-text {
    margin-bottom: 36px !important;
    width: 100% !important;
    min-width: 0;
    max-width: 430px !important;
    padding: 26px 10px 29px !important;
    box-sizing: border-box;
  }

  body.home-page .site-title-main {
    width: auto !important;
    max-width: 100% !important;
    margin-inline: auto !important;
    padding-inline: 0 !important;
    font-size: clamp(2.15rem, 10.2vw, 2.9rem) !important;
    line-height: 1.06 !important;
    white-space: nowrap;
  }

  body.home-page .site-subtitle-main.hero-subtitle-reveal {
    width: auto;
    max-width: 100%;
    margin-inline: auto !important;
    font-size: clamp(0.68rem, 3.1vw, 0.82rem) !important;
    line-height: 1.45 !important;
    white-space: normal;
    text-wrap: balance;
  }

  body.home-page .posts-section,
  body.home-page .post-card,
  body.home-page .post-card-featured {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  body.home-page .hero-section {
    height: 68svh !important;
    min-height: 440px !important;
    max-height: 600px;
  }

  body.home-page .scroll-down { bottom: 80px !important; }
  body.home-page .posts-section { padding-top: 32px !important; }

  body .index .post-card .post-card-image { width: 100% !important; }

  body .content .reading-surface .post-body ul,
  body .content .reading-surface .post-body ol { padding-inline-start: 1.25em !important; }
}

@media (max-width: 360px) {
  body.home-page .hero-content {
    padding-right: 22px !important;
    padding-left: 22px !important;
  }

  body.home-page .site-title-main {
    font-size: clamp(1.95rem, 10vw, 2.28rem) !important;
  }
}

.site-nav-toggle button.toggle {
  appearance: none;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}
.site-nav-toggle button.toggle:focus-visible {
  outline: 2px solid var(--gold-accent);
  outline-offset: 5px;
}
