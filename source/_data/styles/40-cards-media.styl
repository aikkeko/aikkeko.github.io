  padding: 8px 13px;
  border: 1px solid rgba(212, 196, 168, 0.13);
  border-radius: 0;
  background: rgba(255, 255, 255, 0.018);
  color: rgba(232, 228, 220, 0.6);
  font-family: $font-family-monospace;
  font-size: 0.69rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;

  &:hover,
  &.is-active {
    border-color: rgba(106, 160, 154, 0.48);
    background: linear-gradient(135deg, rgba(106, 160, 154, 0.16), rgba(212, 196, 168, 0.055));
    color: #f0e8d8;
  }

  &:focus-visible {
    outline: 2px solid rgba(212, 196, 168, 0.68);
    outline-offset: 2px;
  }
}

.media-search {
  display: flex;
  align-items: center;
  min-width: 0;
  border: 1px solid rgba(212, 196, 168, 0.13);
  background: rgba(8, 10, 14, 0.28);

  i {
    flex: 0 0 auto;
    margin-left: 13px;
