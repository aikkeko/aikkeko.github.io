// ============================================
// 59. Signal archive embedded player
// ============================================
.media-card-cover.has-embed {
  align-self: stretch;
  display: flex;
  align-items: center;
  width: 100%;
  height: 100% !important;
  min-height: 0;
  padding: 14px;
  box-sizing: border-box;
  aspect-ratio: auto;
  background:
    radial-gradient(circle at 50% 50%, rgba(106, 160, 154, 0.1), transparent 36%),
    #101218;

  &::after {
    display: none;
  }
}

.media-card.has-player:not(.is-featured) {
  grid-template-rows: auto 1fr;
}

.media-card.is-featured.has-player {
  grid-template-rows: minmax(0, 1fr);
  align-items: stretch;
}

.media-card-player {
  position: relative;
  flex: 0 0 auto;
  overflow: hidden;
  width: 100%;
  height: auto;
  min-height: 0;
  aspect-ratio: 16 / 9;
  background:
    radial-gradient(circle at 50% 50%, rgba(106, 160, 154, 0.1), transparent 34%),
    #101218;
}

.media-player-frame,
.media-player-frame iframe {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.media-player-frame[hidden],
.media-player-launch[hidden] {
  display: none !important;
}

.media-player-frame iframe {
  border: 0;
  background: #101218;
}

.media-player-launch {
  position: absolute;
  inset: 0;
  overflow: hidden;
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  background:
    linear-gradient(180deg, rgba(12, 14, 18, 0.08), rgba(8, 10, 14, 0.72)),
    repeating-linear-gradient(90deg, transparent 0, transparent 39px, rgba(212, 196, 168, 0.035) 39px, rgba(212, 196, 168, 0.035) 40px),
    linear-gradient(145deg, #262a31, #111319);
  color: #e8e4dc;
  cursor: pointer;

  > img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #0d1015;
    opacity: 0.76;
  }

  &::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(212, 196, 168, 0.1);
    pointer-events: none;
  }

  &:hover .media-player-play,
  &:focus-visible .media-player-play {
    border-color: rgba(212, 196, 168, 0.72);
    background: rgba(106, 160, 154, 0.2);
    transform: scale(1.06);
  }

  &:focus-visible {
    outline: 2px solid rgba(212, 196, 168, 0.74);
    outline-offset: -4px;
  }
}

.media-player-play {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 62px;
  height: 62px;
  border: 1px solid rgba(212, 196, 168, 0.42);
  border-radius: 50%;
  background: rgba(17, 19, 24, 0.62);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.34);
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;

  i {
    margin-left: 3px;
    font-size: 1rem;
  }
}

.media-card.is-featured .media-card-player {
  min-height: 0;
}

@media (max-width: 900px) {
  .media-card.has-player,
  .media-card.is-featured.has-player {
    grid-template-rows: auto 1fr;
  }

  .media-card-cover.has-embed {
    height: auto !important;
  }

  .media-card.is-featured .media-card-player {
    min-height: 0;
  }
}

@media (max-width: 560px) {
  .media-card-player,
  .media-card.is-featured .media-card-player {
    min-height: 0;
  }

  .media-player-play {
    width: 54px;
    height: 54px;
  }

  .media-card-cover.has-embed {
    padding: 10px;
  }
}

// ============================================
// 65. Signal titles - compact CJK editorial rhythm
// ============================================
.media-archive .media-card-title {
  max-width: 100%;
  margin-top: 8px;
  font-feature-settings: "kern" 1 !important;
  font-kerning: normal;
  font-size: 1.22rem;
  line-height: 1.38;
  letter-spacing: -0.025em !important;
  word-spacing: normal !important;
  text-align: left !important;
  text-align-last: left !important;
  text-justify: auto !important;
  text-wrap: pretty;
  overflow-wrap: break-word;
}

.media-archive .media-card.is-featured .media-card-title {
  font-size: clamp(1.42rem, 1.82vw, 1.72rem);
  line-height: 1.36;
  letter-spacing: -0.03em !important;
}

@media (max-width: 768px) {
  .media-archive .media-card-title,
  .media-archive .media-card.is-featured .media-card-title {
    letter-spacing: -0.02em !important;
  }
}
