    gap: 12px !important;
    padding: 10px !important;
  }

  .index .post-card .post-card-content,
  .index .post-card-featured .post-card-content {
    padding: 8px 0 10px !important;
  }
}

// 52. Cover loading state - reveal artwork only after the complete image arrives
.index .post-card-image {
  position: relative !important;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.035) 25%, transparent 25%) 0 0 / 12px 12px,
    linear-gradient(315deg, rgba(255, 255, 255, 0.02) 25%, transparent 25%) 0 0 / 12px 12px,
    linear-gradient(135deg, #30343a, #20242a) !important;
}

.index .post-card-image::before {
  content: '' !important;
  position: absolute !important;
  top: 50% !important;
  left: 50% !important;
  z-index: 4 !important;
  width: 26px !important;
  height: 26px !important;
  margin: -13px 0 0 -13px !important;
  border: 1px solid rgba(212, 196, 168, 0.22) !important;
  border-top-color: rgba(212, 196, 168, 0.86) !important;
  border-right-color: rgba(106, 160, 154, 0.78) !important;
  border-radius: 50% !important;
  opacity: 1 !important;
  animation: archive-cover-spin 0.9s linear infinite !important;
  pointer-events: none !important;
  transition: opacity 0.28s ease !important;
}

.index .post-card-image .post-card-cover {
  position: relative;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.42s ease;
}

.index .post-card-image.is-loaded::before {
  opacity: 0 !important;
  animation: none !important;
}

.index .post-card-image.is-loaded .post-card-cover {
  opacity: 1;
}

@keyframes archive-cover-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .index .post-card-image::before {
    animation: none !important;
  }
}

// 53. Homepage background reveal - UI remains visible while the wasteland emerges
.archive-background-opening {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: rgba(3, 4, 5, 0.92);
  opacity: 1;
  visibility: visible;
  pointer-events: none;
}

.archive-background-opening.is-revealing {
  animation: archive-background-reveal 1.35s cubic-bezier(0.18, 0.72, 0.22, 1) 0.72s forwards;
}

@keyframes archive-background-reveal {
  0% {
    opacity: 1;
  }

  100% {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
}

