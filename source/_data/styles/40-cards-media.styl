  }

  input {
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 7px 12px;
    border: 0;
    outline: 0;
    background: transparent;
    color: rgba(240, 232, 216, 0.9);
    font-size: 0.84rem;

    &::placeholder {
      color: rgba(200, 200, 204, 0.42);
    }
  }

  &:focus-within {
    border-color: rgba(106, 160, 154, 0.48);
    box-shadow: 0 0 0 2px rgba(106, 160, 154, 0.08);
  }
}

.media-result-counter {
  color: rgba(200, 200, 204, 0.52);
  font-family: $font-family-monospace;
  font-size: 0.66rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;

  strong {
    color: var(--media-gold);
    font-size: 0.9rem;
    font-weight: 500;
  }
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.media-card {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-rows: 210px 1fr;
  min-width: 0;
  border: 1px solid rgba(212, 196, 168, 0.16);
  background:
    linear-gradient(150deg, rgba(43, 46, 53, 0.82), rgba(17, 19, 24, 0.72));
  box-shadow: 0 20px 44px rgba(0, 0, 0, 0.25);
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;

  &::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(255, 255, 255, 0.026);
    pointer-events: none;
  }

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(212, 196, 168, 0.3);
    box-shadow: 0 26px 58px rgba(0, 0, 0, 0.34);
  }

  &[hidden] {
    display: none !important;
  }

  &.is-featured {
    grid-column: 1 / -1;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: minmax(310px, auto);
  }
}

.media-card-cover {
  position: relative;
  overflow: hidden;
  min-height: 0;
  background: #171a20;

  &::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 46%, rgba(8, 10, 14, 0.66)),
      repeating-linear-gradient(0deg, transparent 0, transparent 5px, rgba(255, 255, 255, 0.018) 5px, rgba(255, 255, 255, 0.018) 6px);
    pointer-events: none;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  &.is-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 46%, rgba(106, 160, 154, 0.14), transparent 30%),
      linear-gradient(145deg, #252830, #15171c);

    > i {
      color: rgba(212, 196, 168, 0.42);
      font-size: 3rem;
      filter: drop-shadow(0 0 22px rgba(106, 160, 154, 0.16));
    }
  }
}

.media-card:hover .media-card-cover img {
  transform: scale(1.025);
}

.media-card-kind {
  position: absolute;
  left: 18px;
  bottom: 16px;
  z-index: 1;
  padding: 5px 8px;
  border: 1px solid rgba(212, 196, 168, 0.22);
  background: rgba(12, 14, 18, 0.62);
  color: rgba(232, 228, 220, 0.76);
  font-family: $font-family-monospace;
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.media-card-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 25px 26px 26px;
}

.media-card-title {
  margin: 13px 0 10px;
  color: #eee6d8;
  font-family:
    "Source Han Serif SC",
    "Noto Serif CJK SC",
    "Noto Serif SC",
    "Songti SC",
    "STSong",
    "SimSun",
    Georgia,
    serif;
  font-size: 1.3rem;
  font-weight: 500;
  font-synthesis: none;
  font-feature-settings: "kern" 1, "palt" 1;
  line-height: 1.46;
  letter-spacing: 0.018em;
  text-wrap: balance;
  text-shadow:
    0 1px 0 rgba(255, 255, 255, 0.04),
    0 4px 18px rgba(0, 0, 0, 0.42);
}

.media-card.is-featured .media-card-title {
  font-size: clamp(1.52rem, 2.05vw, 1.86rem);
  line-height: 1.42;
  letter-spacing: 0.012em;
}

.media-card-description {
  margin: 0 0 18px;
  color: rgba(222, 219, 214, 0.68);
  font-size: 0.91rem;
  line-height: 1.9;
  letter-spacing: 0.012em;
  text-wrap: pretty;
}

@supports (-webkit-background-clip: text) {
  .media-card-title {
    background: linear-gradient(180deg, #fffaf0 0%, #e6ded0 68%, #c2b59b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
}

.media-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 15px;
  margin-top: auto;
  padding-top: 13px;
  border-top: 1px solid rgba(212, 196, 168, 0.1);
  color: rgba(200, 200, 204, 0.58);
  font-family: $font-family-monospace;
  font-size: 0.7rem;
  letter-spacing: 0.04em;

  span,
  time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  i {
    color: rgba(106, 160, 154, 0.7);
  }
}

.media-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;

  span {
    padding: 4px 7px;
    border: 1px solid rgba(212, 196, 168, 0.11);
    color: rgba(212, 196, 168, 0.62);
    font-size: 0.68rem;
  }
}

.media-card-action {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 10px;
  margin-top: 18px;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 3px;
  padding-left: 0;
  border-top: 0;
  border-right: 0;
  border-bottom: 1px solid rgba(106, 160, 154, 0.4);
  border-left: 0;
  background: transparent;
  color: rgba(240, 232, 216, 0.82) !important;
  font-family: $font-family-monospace;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
  cursor: pointer;

  &:hover {
    color: #fff8ea !important;
    border-bottom-color: var(--media-gold);
  }

  &.is-disabled {
    border-bottom-color: rgba(200, 200, 204, 0.16);
    color: rgba(200, 200, 204, 0.36) !important;
  }
}

.media-empty-state,
.media-no-results {
  display: grid;
  place-items: center;
  min-height: 280px;
  padding: 42px 24px;
  border: 1px solid rgba(212, 196, 168, 0.16);
  background:
    radial-gradient(circle at 50% 45%, rgba(106, 160, 154, 0.09), transparent 26%),
    linear-gradient(145deg, rgba(28, 31, 38, 0.66), rgba(15, 17, 22, 0.46));
  text-align: center;

  > i {
    color: rgba(106, 160, 154, 0.4);
    font-size: 2.8rem;
  }

  > span {
    margin-top: 18px;
    color: rgba(212, 196, 168, 0.72);
    font-family: $font-family-monospace;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
  }

  p {
    margin: 10px 0 0;
    color: rgba(200, 200, 204, 0.54);
    font-size: 0.86rem;
  }

  button {
    margin-top: 16px;
    padding: 8px 13px;
    border: 1px solid rgba(212, 196, 168, 0.2);
    background: rgba(212, 196, 168, 0.06);
    color: rgba(240, 232, 216, 0.76);
    cursor: pointer;
  }
}

.media-no-results[hidden] {
  display: none;
}

.media-visually-hidden {
  position: absolute;
  overflow: hidden;
  width: 1px;
  height: 1px;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

@media (max-width: 900px) {
  .media-toolbar {
    grid-template-columns: 1fr auto;
  }

  .media-search {
    grid-column: auto;
    grid-row: auto;
  }

  .media-grid {
    grid-template-columns: 1fr;
  }

  .media-card.is-featured {
    grid-column: auto;
    grid-template-columns: 1fr;
    grid-template-rows: 240px 1fr;
  }
}

@media (max-width: 560px) {
  .media-toolbar {
    grid-template-columns: 1fr;
  }

  .media-search,
  .media-result-counter {
    grid-column: auto;
    grid-row: auto;
  }

  .media-card,
  .media-card.is-featured {
    grid-template-rows: 205px 1fr;
  }

  .media-card-content {
    padding: 21px 20px 23px;
  }
}

