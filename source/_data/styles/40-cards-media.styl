// 50. Homepage card hierarchy - keep the sequence marker out of artwork
// The number belongs to the record, not to its cover. Keeping it in the text
// panel preserves image composition and makes every marker readable.
.index .post-card {
  counter-increment: post-card !important;
}

.index .post-card::before {
  content: none !important;
  counter-increment: none !important;
}

.index .post-card-content {
  position: relative !important;
}

.index .post-card-content::after {
  content: none !important;
}

.index .post-card-heading {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) auto !important;
  align-items: start !important;
  gap: 12px !important;
}

.index .post-card-index {
  display: block !important;
  min-width: 44px !important;
  color: rgba(212, 196, 168, 0.25) !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-size: 2.1em !important;
  font-weight: 400 !important;
  letter-spacing: 0.02em !important;
  line-height: 1 !important;
  text-align: right !important;
  pointer-events: none !important;
}

.index .post-card-index::before {
  content: counter(post-card, decimal-leading-zero) !important;
}

.index .post-card-title,
.index .post-card-featured .post-card-title {
  position: relative;
  z-index: 2;
  min-width: 0 !important;
  max-width: 100% !important;
  padding-right: 0 !important;
  text-wrap: pretty;
  line-break: strict;
  word-break: normal;
  overflow-wrap: break-word;
}

.index .post-card-title a {
  display: block;
}

@media (max-width: 768px) {
  .index .post-card-title,
  .index .post-card-featured .post-card-title {
    max-width: 100% !important;
  }

  .index .post-card-heading {
    gap: 9px !important;
  }

  .index .post-card-index {
    min-width: 38px !important;
    font-size: 1.8em !important;
  }
}

// 51. Homepage cover framing - give every image breathing room inside its record
.index .post-card {
  box-sizing: border-box !important;
  gap: clamp(18px, 2vw, 28px) !important;
  padding: clamp(14px, 1.5vw, 18px) !important;
}

.index .post-card .post-card-content,
.index .post-card-featured .post-card-content {
