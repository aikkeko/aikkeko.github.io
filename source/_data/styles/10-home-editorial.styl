      }

      .post-card-excerpt {
        font-size: 1em;
        color: #b4b1ac;
      }
    }
  }

  .post-card-content {
    position: relative;
  }
}

.post-banner {
  position: relative;
  isolation: isolate;

  &::before {
        content: 'ARCHIVE RECORD';
    position: absolute;
    top: 22px;
    left: 28px;
    z-index: 3;
    padding: 5px 9px;
    color: rgba(232, 228, 220, 0.72);
    border: 1px solid rgba(212, 196, 168, 0.28);
    background: rgba(16, 18, 22, 0.32);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.68em;
    letter-spacing: 0.15em;
  }

  &::after {
    content: '';
    position: absolute;
    inset: 14px;
    z-index: 2;
    border: 1px solid rgba(212, 196, 168, 0.16);
    pointer-events: none;
  }
}

.post-banner-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  width: fit-content;
  max-width: min(760px, 100%);
  gap: 0;
  margin-top: 18px;
  padding: 7px;
  border: 1px solid rgba(212, 196, 168, 0.18);
  background:
    linear-gradient(90deg, rgba(11, 13, 18, 0.62), rgba(24, 27, 34, 0.36)),
    repeating-linear-gradient(90deg, transparent 0, transparent 11px, rgba(255, 255, 255, 0.025) 11px, rgba(255, 255, 255, 0.025) 12px);
  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.26),
    0 0 0 1px rgba(255, 255, 255, 0.035) inset;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  span {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    margin-right: 0;
    padding: 6px 11px;
    border: 0;
    border-right: 1px solid rgba(212, 196, 168, 0.13);
    background: transparent;
    color: rgba(239, 235, 226, 0.86);
    font-family:
      "Courier New",
      Consolas,
      "PingFang SC",
      "Microsoft YaHei",
      monospace;
    font-size: 0.86em;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.02em;

    &:last-child {
      border-right: 0;
    }

    i {
      display: inline-grid;
      place-items: center;
      width: 18px;
      height: 18px;
      color: rgba(106, 160, 154, 0.92);
      font-size: 0.9em;
      text-shadow: 0 0 12px rgba(106, 160, 154, 0.18);
    }
  }
}

.posts-expand.post .post-block {
  border-radius: 3px;
  background:
    linear-gradient(180deg, rgba(43, 46, 53, 0.9), rgba(28, 31, 38, 0.88)) !important;
}

.posts-expand.post .post-body {
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}

.post-body blockquote {
  position: relative;
  border-left: 0;
  padding: 22px 26px 22px 32px;
  background:
    linear-gradient(90deg, rgba(212, 196, 168, 0.13), rgba(35, 38, 45, 0.28));
  border-top: 1px solid rgba(212, 196, 168, 0.12);
  border-bottom: 1px solid rgba(212, 196, 168, 0.1);

  &::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18px;
    bottom: 18px;
    width: 3px;
    background: linear-gradient(180deg, #d4c4a8, rgba(106, 160, 154, 0.45));
  }
}

@media (min-width: 992px) {
  .index .post-card:nth-child(even) {
    transform: translateX(24px);

    &:hover {
      transform: translateX(24px) translateY(-6px);
    }
  }

  .index .post-card:nth-child(odd):not(:first-child) {
    transform: translateX(-24px);

    &:hover {
      transform: translateX(-24px) translateY(-6px);
    }
  }
}

@media (max-width: 768px) {
  .index {
    .hero-section::after {
      left: 18px;
      right: 18px;
      top: 92px;
      bottom: 44px;
    }

    .hero-content::before,
    .hero-content::after {
      display: none;
    }

    .post-card,
    .post-card-featured {
      display: flex;
      min-height: 0;
      transform: none !important;
    }

    .post-card:nth-child(even) .post-card-image {
      order: 0;
    }

    .post-card-featured {
      .post-card-image {
        min-height: 220px;
      }

      .post-card-content {
        padding: 24px;
      }

      .post-card-title {
        font-size: 1.42em;
      }
    }
  }

  .post-banner::before {
    top: 14px;
    left: 16px;
    font-size: 0.58em;
  }

  .post-banner::after {
    inset: 9px;
  }

  .post-banner-meta {
    width: 100%;
    max-width: 100%;
    gap: 6px;
    padding: 8px;
    background: rgba(11, 13, 18, 0.58);

    span {
      flex: 1 1 calc(50% - 6px);
      justify-content: flex-start;
      border: 1px solid rgba(212, 196, 168, 0.12);
      background: rgba(18, 20, 26, 0.22);
      font-size: 0.78em;

      &:last-child {
        border-right: 1px solid rgba(212, 196, 168, 0.12);
      }
    }
  }

  .posts-expand.post .post-body {
    max-width: 100%;
  }
}
