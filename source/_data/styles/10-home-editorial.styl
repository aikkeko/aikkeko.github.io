// 23. 首页沉浸式全屏 Hero - 增强版（无遮罩顶部导航）
// ============================================
.index {
  // 内容区域样式
  .content-wrap {
    padding: 0;
    background: transparent !important;
  }

  .content {
    padding: 0;
  }

  // 显示顶部导航并透明化
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent !important;
    border-bottom: none;
    box-shadow: none;

    .header-inner {
      background: transparent !important;
      backdrop-filter: none;
      border-bottom: none;
      box-shadow: none;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 40px;
    }

    // 站点标题和副标题
    .site-brand-container {
      white-space: nowrap;

      .site-title {
        font-size: 1.4em;
        font-weight: 600;
        color: #e8e4dc;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
        white-space: nowrap;
        display: inline-block;
      }

      .site-subtitle {
        font-size: 0.85em;
        color: rgba(255, 255, 255, 0.7);
        text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
        white-space: nowrap;
        display: inline-block;
      }
    }

    // 导航菜单
    .menu {
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
      border-radius: 30px;
      padding: 8px 20px;

      .menu-item {
        margin: 0 8px;

        a {
          color: rgba(255, 255, 255, 0.9);
          padding: 8px 16px;
          border-radius: 20px;
          transition: all 0.3s ease;

          &:hover {
            background: rgba(180, 160, 120, 0.3);
            color: #d4c4a8;
          }
        }

        &.menu-item-active a {
          background: rgba(180, 160, 120, 0.4);
          color: #d4c4a8;
        }
      }
    }

    // 搜索按钮
    .site-nav-toggle,
    .toggle {
      color: rgba(255, 255, 255, 0.9);

      &:hover {
        color: #d4c4a8;
      }
    }
  }

  // 主内容区域样式
  .content-wrap {
    padding: 0;
    background: transparent !important;
  }

  // Hero 区域全屏
  .hero-section {
    position: relative;
    width: 100%;
    height: 88vh;
    min-height: 560px;
    background: no-repeat center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;

    @media (max-width: 768px) {
      height: 76svh;
      min-height: 520px;
      background-attachment: scroll;
    }
  }

  // 暗色遮罩
  .hero-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      rgba(25, 28, 35, 0.3) 0%,
      rgba(25, 28, 35, 0.5) 50%,
      rgba(25, 28, 35, 0.7) 100%
    );
    z-index: 1;
  }

  // 内容区域
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 80px 20px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  // 标题区域
  .hero-text {
    margin-bottom: 60px;
  }

  // 主标题 - 大字震撼效果
  .site-title-main {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 700;
    margin: 0 0 20px 0;
    letter-spacing: 4px;
    color: #e8e4dc;
    text-shadow:
      0 2px 10px rgba(0, 0, 0, 0.8),
      0 4px 30px rgba(0, 0, 0, 0.5);
    animation: fadeInUp 1s ease-out;

    @media (max-width: 768px) {
      max-width: 8em;
      font-size: clamp(2.15rem, 11vw, 2.75rem);
      line-height: 1.18;
      letter-spacing: 1px;
    }
  }

  // 副标题
  .site-subtitle-main {
    font-size: 1.5em;
    font-weight: 300;
    margin: 0;
    color: #b4a078;
    letter-spacing: 3px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
    animation: fadeInUp 1s ease-out 0.3s both;
    min-height: 1.5em;

    @media (max-width: 768px) {
      max-width: 22em;
      font-size: 0.95em;
      letter-spacing: 0.5px;
    }

    // 打字光标效果
    &::after {
      content: '|';
      animation: blink 1s infinite;
      margin-left: 2px;
    }
  }

  // 向下滚动指示器
  .scroll-down {
    position: absolute;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    animation: fadeInUp 1s ease-out 0.6s both;
    transition: all 0.3s ease;

    &:hover {
      color: #d4c4a8;

      .scroll-down-icon {
        transform: translateY(5px);
      }

      .scroll-down-line {
        background: #d4c4a8;
      }
    }

    // 图标容器
    .scroll-down-icon {
      width: 50px;
      height: 50px;
      border: 2px solid rgba(255, 255, 255, 0.5);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2em;
      margin-bottom: 15px;
      transition: all 0.3s ease;
      animation: float 2s ease-in-out infinite;

      &:hover {
        border-color: #d4c4a8;
        background: rgba(180, 160, 120, 0.1);
      }
    }

    // 线条
    .scroll-down-line {
      width: 1px;
      height: 60px;
      background: rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }
  }
}

// 长文本使用浏览器原生渐进绘制，完整 DOM 始终保留给搜索、TOC 与书签。
.long-text-chunk {
  content-visibility: auto;
  contain-intrinsic-size: auto 900px;
}

// 尊重系统的低动效设置，文学阅读时避免持续闪烁和漂浮。
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

// 动画定义
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes blink {
  0%, 50% {
    opacity: 1;
  }
  51%, 100% {
    opacity: 0;
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

// ============================================
// 24. 文章列表区域 - 首页下方
// ============================================
.posts-section {
  background: transparent;
  padding: 60px 0;

  .posts-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }
}

// 文章卡片在首页的样式
.index .post-card {
  display: flex;
  background: rgba(35, 38, 45, 0.8);
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 30px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(180, 160, 120, 0.1);
  transition: all 0.3s ease;

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    border-color: rgba(180, 160, 120, 0.2);
  }

  @media (max-width: 768px) {
    flex-direction: column;
  }

  // 文章图片
  .post-card-image {
    flex: 0 0 280px;
    overflow: hidden;
    background: #1e2128 url('/images/Z.A.T.O_02_ca04.jpg') no-repeat center center;
    background-size: cover;

    @media (max-width: 768px) {
      flex: none;
      height: 200px;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    &:hover img {
      transform: scale(1.05);
    }
  }

  // 文章内容
  .post-card-content {
    flex: 1;
    padding: 25px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    @media (max-width: 768px) {
      padding: 20px;
    }
  }

  .post-card-title {
    font-size: 1.4em;
    font-weight: 600;
    margin: 0 0 15px 0;
    line-height: 1.4;

    a {
      color: #e8e4dc;
      border-bottom: none;
      transition: color 0.3s ease;

      &:hover {
        color: #d4c4a8;
      }
    }
  }

  .post-card-excerpt {
    color: #9a9a9f;
    font-size: 0.95em;
    line-height: 1.7;
    margin-bottom: 20px;
    flex: 1;
  }

  .post-card-meta {
    font-size: 0.85em;
    color: #7a7a80;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;

    .post-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;

      i {
        color: rgba(180, 160, 120, 0.6);
        font-size: 0.9em;
      }

      a {
        color: #8a8a90;
        border-bottom: none;

        &:hover {
          color: #d4c4a8;
        }
      }
    }
  }
}

