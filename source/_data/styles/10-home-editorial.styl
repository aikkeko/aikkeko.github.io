    isolation: isolate;

    &::after {
      content: '';
      position: absolute;
      left: unquote('max(24px, 4vw)');
      right: unquote('max(24px, 4vw)');
      top: unquote('max(86px, 11vh)');
      bottom: 64px;
      z-index: 2;
      pointer-events: none;
      border: 1px solid rgba(212, 196, 168, 0.22);
      background:
        linear-gradient(90deg, rgba(212, 196, 168, 0.55) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.55) calc(100% - 48px)) top / 100% 1px no-repeat,
        linear-gradient(90deg, rgba(212, 196, 168, 0.55) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.55) calc(100% - 48px)) bottom / 100% 1px no-repeat,
        linear-gradient(180deg, rgba(212, 196, 168, 0.55) 0 48px, transparent 48px calc(100% - 48px), rgba(212, 196, 168, 0.55) calc(100% - 48px)) left / 1px 100% no-repeat,
