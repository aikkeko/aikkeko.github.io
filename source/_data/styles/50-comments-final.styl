// ============================================
// 69. Mobile background drift - scroll-linked, cache-safe preview
// ============================================
@media (max-width: 767px) {
  html {
    background: #1e2128;
  }

  body {
    background-image: none !important;
    background-color: #1e2128 !important;
  }

  body::after {
    position: fixed;
    inset: -18vh 0;
    z-index: 0;
    background:
      radial-gradient(circle at 18% 16%, rgba(212, 196, 168, 0.08), transparent 28%),
      linear-gradient(180deg, rgba(12, 14, 18, 0.05), rgba(12, 14, 18, 0.24)),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px),
      url('/images/Z.A.T.O_02_ca04.jpg') no-repeat center center;
    background-size: auto, auto, 72px 72px, 72px 72px, cover;
    mix-blend-mode: normal;
    opacity: 1;
    transform: translate3d(0, var(--mobile-bg-shift, 0px), 0);
    will-change: transform;
  }
}

@media (max-width: 767px) and (prefers-reduced-motion: reduce) {
  body::after {
    transform: none;
    will-change: auto;
  }
}

