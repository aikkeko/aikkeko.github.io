// ============================================
// 66. GitHub discussion terminal
// ============================================
.giscus-comments {
  position: relative;
  overflow: hidden;
  width: min(100%, 920px);
  margin: 42px auto 0 !important;
  padding: 0 !important;
  border: 1px solid rgba(212, 196, 168, 0.16) !important;
  background: linear-gradient(145deg, rgba(38, 41, 48, 0.97), rgba(20, 22, 27, 0.985));
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.36),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
  backdrop-filter: blur(16px);
  overflow-anchor: none;

  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 96px;
    height: 2px;
    background: linear-gradient(90deg, #b4a078, rgba(106, 160, 154, 0.62), transparent);
  }
}

.giscus-comments-header {
  position: relative;
  padding: 18px 24px 16px 28px;
  border-bottom: 1px solid rgba(212, 196, 168, 0.13);
  background: linear-gradient(90deg, rgba(180, 160, 120, 0.055), transparent 58%);

  &::before {
    content: '';
    position: absolute;
    top: 19px;
    bottom: 18px;
    left: 18px;
    width: 2px;
    background: linear-gradient(#b4a078, rgba(106, 178, 168, 0.44));
  }

  h2 {
    margin: 7px 0 4px !important;
    color: #eee6d8;
    font-family: var(--font-display) !important;
    font-size: clamp(1.25rem, 1.7vw, 1.52rem) !important;
    font-weight: 500 !important;
    line-height: 1.25 !important;
    letter-spacing: 0.025em !important;
    text-shadow: 0 5px 20px rgba(0, 0, 0, 0.38);
  }

  p {
    margin: 0 !important;
    color: rgba(207, 205, 201, 0.64);
    max-width: 680px;
    font-size: 0.79rem;
    line-height: 1.65;
  }
}

.giscus-comments-kicker {
  color: rgba(106, 178, 168, 0.78);
  font-family: var(--font-label) !important;
  font-size: 0.59rem;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.14em;
}

.giscus-comments-body {
  position: relative;
  padding: 12px 16px 14px;
  background: rgba(10, 12, 16, 0.24);
  overflow-anchor: none;
}

.giscus {
  position: relative;
  padding: 6px 8px 2px;
  border: 1px solid rgba(212, 196, 168, 0.09);
  background: rgba(10, 12, 17, 0.34);
}

.giscus,
.giscus-frame {
  width: 100%;
}

.giscus-frame {
  display: block;
  min-height: 280px;
  color-scheme: dark;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.35s ease, transform 0.35s ease;
}

.giscus-comments-body.is-giscus-ready {
  .giscus-frame {
    opacity: 1;
    transform: none;
  }

  .giscus-comments-loading {
    opacity: 0;
    visibility: hidden;
  }
}

.giscus-comments-loading {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 13px;
  color: rgba(200, 200, 204, 0.45);
  font-family: var(--font-label) !important;
  letter-spacing: 0.13em;
  pointer-events: none;
  transform: translate(-50%, -50%);
  transition: opacity 0.28s ease, visibility 0.28s ease;

  span {
    width: 24px;
    height: 24px;
    border: 1px solid rgba(180, 160, 120, 0.2);
    border-top-color: rgba(106, 178, 168, 0.82);
    border-radius: 50%;
    animation: echo-giscus-spin 0.85s linear infinite;
  }

  small {
    font-size: 0.56rem;
  }
}

@keyframes echo-giscus-spin {
  to {
    transform: rotate(360deg);
  }
}

.giscus-github-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 9px 8px 0;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(106, 160, 154, 0.32);
  color: rgba(212, 196, 168, 0.7) !important;
  font-family: var(--font-label) !important;
  font-size: 0.66rem;
  letter-spacing: 0.1em;

  &:hover {
    color: #eee6d8 !important;
    border-bottom-color: rgba(212, 196, 168, 0.68);
  }
}

.giscus-pending {
  display: flex;
  align-items: center;
  gap: 18px;
  margin: 25px 28px 28px;
  padding: 20px 22px;
  border: 1px solid rgba(212, 196, 168, 0.12);
  background: rgba(11, 13, 18, 0.34);

  strong {
    display: block;
    color: rgba(232, 228, 220, 0.82);
    font-family: var(--font-display) !important;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  p {
    margin: 5px 0 0 !important;
    color: rgba(200, 200, 204, 0.46);
    font-family: var(--font-label) !important;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }
}

.giscus-pending-mark {
  display: grid;
  place-items: center;
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  border: 1px solid rgba(106, 160, 154, 0.24);
  color: rgba(106, 178, 168, 0.72);
  font-size: 1rem;
  transform: rotate(45deg);

  i {
    transform: rotate(-45deg);
  }
}

@media (max-width: $viewport-mobile) {
  .giscus-comments {
    width: 100%;
    margin-top: 24px !important;
  }

  .giscus-comments-header {
    padding: 17px 16px 15px 24px;

    h2 {
      font-size: 1.28rem !important;
    }

    &::before {
      top: 18px;
      bottom: 17px;
      left: 15px;
    }
  }

  .giscus-comments-body {
    padding: 9px 7px 12px;
  }

  .giscus {
    padding: 4px;
  }

  .giscus-frame {
    min-height: 306px;
  }

  .giscus-pending {
    align-items: flex-start;
    margin: 18px 16px 20px;
    padding: 17px;
  }

  .giscus-pending-mark {
    flex-basis: 40px;
    width: 40px;
    height: 40px;
  }
}

