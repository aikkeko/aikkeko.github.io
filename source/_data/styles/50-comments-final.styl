// ============================================
// 71. Media covers - one balanced safe frame
// ============================================
.media-card-cover.has-embed {
  align-self: start;
  height: auto !important;
  padding: 14px !important;
  background: rgba(10, 12, 16, 0.58);
}

.media-card-cover.has-embed .media-card-player {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  border: 1px solid rgba(212, 196, 168, 0.14);
  background: #0d1015;
  box-shadow:
    0 12px 28px rgba(0, 0, 0, 0.26),
    0 0 0 1px rgba(0, 0, 0, 0.2);
}

.media-player-launch > img {
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  object-fit: contain !important;
  object-position: center center;
  background: #0d1015;
  opacity: 1;
}

.media-player-launch::after {
  inset: 0;
  border-color: rgba(232, 228, 220, 0.055);
}

@media (min-width: 901px) {
  .media-card.is-featured.has-player {
    grid-template-rows: auto;
    align-items: center;
  }

  .media-card.is-featured.has-player .media-card-cover.has-embed {
    align-self: center;
  }
}

@media (max-width: 560px) {
  .media-card-cover.has-embed {
    padding: 10px !important;
  }
}

// ============================================
// 72. Media cover loading state - quiet, stable placeholder
// ============================================
.media-player-launch > img.media-cover-image {
  opacity: 0 !important;
  transition: opacity 0.38s ease !important;
}

.media-player-launch > img.media-cover-image.is-loaded {
  opacity: 1 !important;
}

.media-player-launch > img.media-cover-image.is-error {
  visibility: hidden;
}

@media (prefers-reduced-motion: reduce) {
  .media-player-launch > img.media-cover-image {
    transition: none !important;
  }
}

