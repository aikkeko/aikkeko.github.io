  overflow-wrap: anywhere;
}

.media-card-description.is-collapsible {
  position: relative;
  display: -webkit-box;
  overflow: hidden;
  margin-bottom: 8px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;

  &::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 42%;
    height: 1.9em;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(31, 34, 41, 0.96) 72%);
  }
}

.media-card-description.is-collapsible.is-expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: unset;

  &::after {
    content: none;
  }
}

