  display: inline-flex;
  align-items: center;
  margin: 0 0 18px;
  border-bottom: 1px solid rgba(106, 160, 154, 0.34);
  background: transparent;
  font-family: var(--font-label);
  cursor: pointer;

  &::after {
    color: rgba(212, 196, 168, 0.78);
    font-size: 1rem;
    line-height: 0.8;
  }

  &[aria-expanded='true']::after {
  }

  &:hover,
  &:focus-visible {
    border-bottom-color: rgba(106, 160, 154, 0.7);
  }
}

// Keep the media-description control compact and aligned with its label.
.media-description-toggle {
  align-self: flex-start;
  gap: 7px;
  width: auto !important;
  padding: 3px 2px 4px 0;
  border: 0 !important;
  box-shadow: none !important;
  color: rgba(202, 194, 179, 0.82);
  font-size: 0.7rem;
  line-height: 1.4;
  letter-spacing: 0.1em;

  &::after {
    content: '';
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    margin-left: 1px;
    border: 0;
    border-right: 1px solid rgba(180, 160, 120, 0.86);
    border-bottom: 1px solid rgba(180, 160, 120, 0.86);
    transform: translateY(-2px) rotate(45deg);
    transform-origin: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  &[aria-expanded='true']::after {
    transform: translateY(2px) rotate(225deg);
  }

  &:hover,
  &:focus-visible {
    color: #e4d8c2;
    outline: none;

    &::after {
      border-color: #c8aa72;
    }
  }
}

